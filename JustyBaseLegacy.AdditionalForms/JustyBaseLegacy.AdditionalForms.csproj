<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
	 <NoWarn>$(NoWarn);WFO1000</NoWarn>
	 <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
	 <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AppBase.Common\AppBase.Common.csproj" />
    <ProjectReference Include="..\DatabaseDataGridView.WinForms\source\DatabaseDataGridView.WinForms.csproj" />
    <ProjectReference Include="..\JustData.Application\JustData.Application.csproj" />
    <ProjectReference Include="..\JustData.ViewModels\JustData.ViewModels.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JustyBase.NetezzaDdl" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="DatabaseDataGridView.WinForms" />
  </ItemGroup>
  <ItemGroup>
