    </Compile>
    <Compile Update="ImportChoseTab.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ImportProgressForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ImportTableDataNetezza.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="NetezzaCreateGroup.cs">
