<Project>
  <PropertyGroup>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);WFO1000;MSB3277</NoWarn>
    <Version>1.1.0.22</Version>
    <Authors>Krzysztof Duśko</Authors>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <Platforms Condition="'$(Platforms)' == ''">x64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <!-- DB2, MS SQL Server and PostgreSQL are part of the default desktop
         distribution. It remains possible to opt out explicitly with
         -p:IncludeDB2=false / -p:IncludeMsSql=false / -p:IncludePostgres=false
         for reduced builds. -->
    <IncludeDB2 Condition="'$(IncludeDB2)' == ''">true</IncludeDB2>
    <IncludeMsSql Condition="'$(IncludeMsSql)' == ''">true</IncludeMsSql>
    <IncludePostgres Condition="'$(IncludePostgres)' == ''">true</IncludePostgres>

  </PropertyGroup>
</Project>
