<Project>
  <PropertyGroup>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <Version>1.0.0.2</Version>
    <Authors>Krzysztof Duśko</Authors>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <Platforms Condition="'$(Platforms)' == ''">x64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>

    <!--
      Local sibling checkout (##justybase/JustyBase.NetezzaSql):
      ProjectReference instead of NuGet. Override: -p:UseLocalJustyBaseLibraries=false|true
    -->
    <JustyBaseLibrariesRoot Condition="'$(JustyBaseLibrariesRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</JustyBaseLibrariesRoot>
    <JustyBaseLocalNetezzaProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.Netezza\JustyBase.Netezza.csproj</JustyBaseLocalNetezzaProject>
    <JustyBaseLocalNetezzaSqlParserProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.NetezzaSqlParser.csproj</JustyBaseLocalNetezzaSqlParserProject>
    <JustyBaseLocalNetezzaDdlProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.NetezzaDdl\JustyBase.NetezzaDdl.csproj</JustyBaseLocalNetezzaDdlProject>
    <JustyBaseLocalNetezzaCatalogSqlProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.NetezzaCatalogSql\JustyBase.NetezzaCatalogSql.csproj</JustyBaseLocalNetezzaCatalogSqlProject>
    <JustyBaseLocalCoreProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.Core\JustyBase.Core.csproj</JustyBaseLocalCoreProject>
    <JustyBaseLocalImportExportProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.ImportExport\JustyBase.ImportExport.csproj</JustyBaseLocalImportExportProject>
    <UseLocalJustyBaseLibraries Condition="'$(UseLocalJustyBaseLibraries)' == ''
      and Exists('$(JustyBaseLocalNetezzaProject)')
      and Exists('$(JustyBaseLocalNetezzaSqlParserProject)')
      and Exists('$(JustyBaseLocalNetezzaDdlProject)')
      and Exists('$(JustyBaseLocalNetezzaCatalogSqlProject)')
      and Exists('$(JustyBaseLocalCoreProject)')
      and Exists('$(JustyBaseLocalImportExportProject)')">true</UseLocalJustyBaseLibraries>
    <UseLocalJustyBaseLibraries Condition="'$(UseLocalJustyBaseLibraries)' == ''">false</UseLocalJustyBaseLibraries>

    <!-- NuGet path: always take newest published (incl. preview). Pin via -p:JustyBaseNetezzaLibsPackageVersion=0.2.0-preview.6 -->
    <JustyBaseNetezzaLibsPackageVersion Condition="'$(JustyBaseNetezzaLibsPackageVersion)' == ''">*-*</JustyBaseNetezzaLibsPackageVersion>
  </PropertyGroup>
</Project>
