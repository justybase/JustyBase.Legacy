<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JustData.Application\JustData.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\JustyBase.NetezzaSql\JustyBase.NetezzaSqlParser.csproj" />
    <!-- GitViewModel uses only the dependency-free commit-message contract. -->
    <ProjectReference Include="..\..\JustyBase.NetezzaSql\JustyBase.Ai.Contracts\JustyBase.Ai.Contracts.csproj" />
    <ProjectReference Include="..\..\JustyBase.NetezzaSql\JustyBase.Ai\JustyBase.Ai.csproj"
                      Condition="'$(EnableAi)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableAi)' != 'true'">
    <!-- ChatViewModel depends on the full AI pipeline and is not part of the no-AI build. -->
    <Compile Remove="Ai\**\*.cs" />
  </ItemGroup>
</Project>
