<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JustyBase.Ai.Fim</RootNamespace>
    <Description>Embedded Fill-in-the-Middle SQL completion via LLamaSharp (GGUF).</Description>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableFimCuda)' == 'true'">
    <PackageReference Include="LLamaSharp.Backend.Cuda12" />
  </ItemGroup>
</Project>
